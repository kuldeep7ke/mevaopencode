{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./AGENTS.md"],
  "plugin": [
    "./plugins/console-log-warning.ts",
    "./plugins/dangerous-command-blocker.ts",
    "./plugins/env-protection.ts",
    "./plugins/notification.ts",
    "./plugins/pr-helper.ts",
    "./plugins/pre-commit-check.ts",
    "./plugins/session-summary.ts",
    "./plugins/tool-guardrails.ts",
    "./plugins/type-checker.ts"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env*": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "whoami": "allow",
      "echo *": "allow"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/secrets/**": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "doom_loop": "ask"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--headless", "--channel", "chrome"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["github-mcp-server", "stdio"],
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": false
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": { "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}" },
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "environment": { "DATABASE_URI": "{env:DATABASE_URI}" },
      "enabled": false
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-tavily"],
      "environment": { "TAVILY_API_KEY": "{env:TAVILY_API_KEY}" },
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
      "enabled": false
    }
  }
}